{
  "name": "studyplanner-server",
  "version": "1.0.0",
  "description": "StudyPlanner REST API server — Lab 5",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest --reporter verbose",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:install": "playwright install chromium firefox",
    "lint": "eslint src tests e2e playwright.config.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "migrate:status": "node --env-file=.env src/db/migrate.js --status",
    "seed": "node --env-file=.env src/db/seed.js",
    "secret-scan": "node scripts/secret-scan.js",
    "validate:client": "node scripts/validate-client.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.14.0",
    "lighthouse": "^13.6.0",
    "supertest": "^7.0.0",
    "vitest": "^5.1.0"
  }
}

# StudyPlanner Server — Environment Variables
# Copy to .env and fill real values. NEVER commit .env.

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (Docker local) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studyplanner_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/studyplanner_test

# ---- Session ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_HEX_STRING_AT_LEAST_64_CHARS

# Session cookie lifetime in seconds (default 30 days)
SESSION_MAX_AGE=2592000

# ---- Production only ----
# Set to 1 when behind a reverse proxy (e.g., Render)
TRUST_PROXY=0
# COOKIE_DOMAIN=yourdomain.com

# ---- Seed (optional) ----
# If not set, seed prints random credentials to stdout once and exits
# SEED_EMAIL=demo@example.com
# SEED_PASSWORD=DemoPass1!
# SEED_NAME=Demo User

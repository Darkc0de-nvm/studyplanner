# StudyPlanner Server — Environment Variables
# Copy to .env and fill real values. NEVER commit .env.

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (Docker local) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studyplanner_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/studyplanner_test

# SSL to PostgreSQL: auto | true | false
# auto  = on for NODE_ENV=production and known cloud hosts (Neon/Render)
# true  = always on (managed Postgres)
# false = always off (local Docker, production-like local runs)
DATABASE_SSL=auto
# Verify the server certificate when SSL is on: true | false
# Set false only for managed hosts that present an untrusted CA chain.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---- Session ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_HEX_STRING_AT_LEAST_64_CHARS

# Session cookie lifetime in seconds (default 30 days)
SESSION_MAX_AGE=2592000

# ---- Cookies ----
# Secure flag on the session cookie: auto | true | false
# auto = on only when NODE_ENV=production. Use false for http://localhost.
COOKIE_SECURE=auto
# COOKIE_DOMAIN=yourdomain.com

# ---- Production only ----
# Set to 1 when behind a reverse proxy (e.g., Render)
TRUST_PROXY=0

# ---- Seed (optional) ----
# If not set, seed prints random credentials to stdout once and exits
# SEED_EMAIL=demo@example.com
# SEED_PASSWORD=DemoPass1!
# SEED_NAME=Demo User
# Base date for demo deadlines in YYYY-MM-DD. Defaults to the local today.
# Set 2026-10-06 to reproduce the Lab 4 visual baseline.
# SEED_BASE_DATE=2026-10-06
